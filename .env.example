# Copy to .env and fill in values. Required for local Docker build (Vue Firebase config).
# docker-compose loads .env and passes these as build args.

VUE_APP_APIKEY=
VUE_APP_AUTHDOMAIN=
VUE_APP_DATABASEURL=
VUE_APP_PROJECTID=
VUE_APP_STORAGEBUCKET=
VUE_APP_MESSAGINGSENDERID=
VUE_APP_APPID=

# db host
DB_HOST=localhost
